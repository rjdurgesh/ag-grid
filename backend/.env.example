# OLS Dashboard backend — environment overrides (copy to `.env`; real env vars still win).
# `.env` is gitignored; keep this .example committed as the template.
#
# ONE codebase runs in DEV / STG / PROD — you do NOT keep per-env files in git. Each deployed
# server has its OWN `.env` (or OS env vars) that sets APP_ENV + that env's DB creds; the code is
# identical everywhere. (Optional: keep secret-free .env.<env> templates outside git and copy the
# right one to `.env` at deploy.) See DEPLOYMENT.md → "Environments".

# --- Which environment this backend serves --------------------------------
# PROD | STG | DEV. Drives DB selection in app.load_db_configs() (wire it to read this) + logging.
APP_ENV=PROD

# --- Regression screen (DEV/STG only) --------------------------------------
# Standardized log dir for CHG/reset/trigger sqlplus runs -> <dir>\<YYYYMMDD>\<script>__<db>.log
REGRESSION_LOG_DIR=D:\ols\regression\logs
# Release repo pulled in the "Apply DB changes" step (git required on the server). Only branches
# matching the prefix are listed. AUTH (PAT) is injected into the https URL and stays server-side.
REGRESSION_GIT_URL=
REGRESSION_GIT_AUTH=
REGRESSION_GIT_WORKDIR=D:\ols\regression\work
REGRESSION_BRANCH_PREFIX=release/
# Sub-path of the repo that holds the .sql scripts ('' = repo root).
REGRESSION_SQL_SUBDIR=
# Developer-provided file-copy manifest (JSON: {"items":[{"source","destination"}]}).
REGRESSION_FILECOPY_MANIFEST=
# Step-1 DB refresh API (dummy/stub for now).
REGRESSION_REFRESH_URL=
# A step stuck 'in_progress' longer than this (minutes) is flagged stale/unlockable (crash recovery).
REGRESSION_STEP_STALE_MINUTES=30

# --- Config Ops CSV Upload & Load ------------------------------------------
# NAS dir where each successfully-loaded CSV is archived as <stem>_<username>_<token>.csv (+SHA-256).
CONFIG_UPLOAD_ARCHIVE_DIR=
CONFIG_UPLOAD_MAX_ROWS=200000
CONFIG_UPLOAD_MAX_MB=50
CONFIG_UPLOAD_BATCH_SIZE=5000
# Audit/system columns the load sets itself (never expected in the uploaded file).
CONFIG_UPLOAD_AUDIT_COLUMNS=INSERTED_BY,INSERTED_DATE,INSERTED_ON,UPDATED_BY,UPDATED_DATE,UPDATED_ON
# The customer's 1-1 table -> date column mapping (COB_DT / REPORTING_DT). Point these at your table.
CONFIG_DATE_MAP_TABLE=ols_table_date_map
CONFIG_DATE_MAP_KEY_COL=table_name
CONFIG_DATE_MAP_DATE_COL=date_col

# --- CyberArk (optional) ---------------------------------------------------
# Fetch the sqlplus DB password at RUNTIME from CyberArk (CCP/AIM) over a client-cert call, so it's
# never stored in .env, never logged, and never sent to the UI. Leave CCP_URL empty to fall back to a
# configured password. AppID identifies which schema's credential (a per-DB app_id may override it).
CYBERARK_CCP_URL=
CYBERARK_APP_ID=
CYBERARK_SAFE=
CYBERARK_CLIENT_CERT=
CYBERARK_CLIENT_KEY=
CYBERARK_CA_BUNDLE=
CYBERARK_TIMEOUT=10
CYBERARK_CACHE_TTL=300

# --- CORS ------------------------------------------------------------------
# Prod needs NO CORS (ui_server.py proxies /api same-origin). This is only for LOCAL dev
# (ng serve :4200 → backend :8000). Comma-separated; override only if you call the API cross-origin.
# OLS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Per-screen DUMMY switches (backend analog of the UI's apiMocks) --------
# The BACKEND has no apiMocks — that's a frontend (environment.ts) concept that decides
# whether a request even leaves Angular. THESE flags decide, once a request DOES reach the
# backend, whether that screen serves canned dummy data or calls its real functions:
#   1/true  = serve canned dummy data (no DB/agent needed)
#   0/false = run the real *_real functions (DB / live agent)
# Flip one screen to develop it live without touching the others (and vice-versa).
ORACLE_CC_USE_DUMMY=1
INFRA_HEALTH_USE_DUMMY=1

# --- Oracle Command Center tunables ----------------------------------------
# Tablespace gauge / Used % bar colour thresholds (percent used).
ORACLE_CC_WARN_PCT=85
ORACLE_CC_CRIT_PCT=90
# Drill-down: max biggest children shown per level (partitions / subpartitions).
ORACLE_CC_TOP_CHILD_LIMIT=10
# Temp Tablespace section — MB held thresholds for the row tint (amber / red).
ORACLE_CC_TEMP_WARN_MB=1024
ORACLE_CC_TEMP_CRIT_MB=5120
# App schema the storage sections report on (owner for the segment/index *_real queries).
ORACLE_CC_SCHEMA=OLS
# Dev/demo ONLY: comma-separated scopes to force "unreachable" (grey tab + down banner +
# section errors) without a real outage. Leave EMPTY in real deployments.
ORACLE_CC_FORCE_DOWN=

# --- Section 8 · SQL Intelligence ------------------------------------------
# Canned SQL-Intelligence data (defaults to ORACLE_CC_USE_DUMMY if unset).
SQLI_USE_DUMMY=1
# History window for every plan-timeline / perf / ASH / finder query (needs AWR retention >= this).
SQLI_HISTORY_DAYS=5
# Show the ADMIN-only in-app "Apply fix" button. The recommended plan + copy-ready SQL is ALWAYS
# shown to everyone; this only controls whether the app itself writes the change (on a separate
# privileged/audited connection). Set 0 to make SQL Intelligence recommend-only.
SQLI_ALLOW_APPLY=1
# Plan Analysis (bottleneck) flags: ignore lines below MIN_ROWS; flag amber/red when the
# A-Rows-vs-E-Rows ratio crosses WARN/CRIT; mark table stats stale past STALE_DAYS.
SQLI_MISESTIMATE_MIN_ROWS=1000
SQLI_MISESTIMATE_WARN=10
SQLI_MISESTIMATE_CRIT=100
SQLI_STATS_STALE_DAYS=7

# --- Log Analytics (see config.py) ----------------------------------------
# Max entries /dir returns per folder (anti-hang cap; 0 = unlimited).
# OLS_DIR_LIMIT=500
# /file serves whole file at/under this size (bytes); larger files are windowed.
# OLS_FILE_WINDOW_THRESHOLD=419430400

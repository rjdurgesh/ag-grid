# OLS Dashboard backend — environment overrides (copy to `.env`; real env vars still win).
# `.env` is gitignored; keep this .example committed as the template.
#
# `.env` now holds ONLY: (1) GLOBAL settings shared across screens, (2) SECRETS, and (3) the
# deploy-time DUMMY switches. SCREEN-SPECIFIC, non-secret settings moved to per-feature config files:
#     regression/regression.json  (per scope: git repo, work/log dirs, NAS feed path — see .example)
#     oraclecc/occ.json           (Oracle Command Center thresholds, schema, SQL-Intelligence)
#     config_ops/config_ops.json  (CSV Upload & Load: archive dir, limits, batch size, audit cols)
#     docs/docs.json              (Documentation Center: wikis + per-file overrides)
# Each feature's JSON lives in its OWN folder next to the code (oraclecc/, regression/, …); the loader
# checks the feature folder FIRST, then falls back to the central config/ dir. Copy each
# <folder>/<feature>.example.json → <folder>/<feature>.json on the server (gitignored). The
# legacy env vars below (commented) STILL WORK as a fallback if a JSON key is absent — but the JSON
# files are the preferred home now.
#
# ONE codebase runs in DEV / STG / PROD — no per-env files in git. Each deployed server has its OWN
# `.env` (+ its config/*.json) with that env's values. See DEPLOYMENT.md → "Environments".

# --- Which environment this backend serves (GLOBAL) ------------------------
# PROD | STG | DEV. Drives DB selection in app.load_db_configs() + the DEV/STG-only Regression screen.
APP_ENV=PROD

# --- Backend version (GLOBAL) — shown in the UI footer as "API v…" ----------
# Bump on each backend release. Falls back to 1.0.0 if unset.
APP_VERSION=1.0.0

# --- Secrets ---------------------------------------------------------------
# Regression git token/PAT — injected into the https repo URL server-side, never in a config file or
# the UI. Optionally per scope: REGRESSION_GIT_TOKEN_CIB / _RETAIL / _GROUP (falls back to this).
REGRESSION_GIT_TOKEN=

# CyberArk (optional): fetch the sqlplus DB password at RUNTIME (CCP/AIM, client-cert) so it's never
# stored in .env, never logged, never sent to the UI. Leave CCP_URL empty to fall back to a configured
# password. AppID identifies which schema's credential (a per-DB app_id may override it).
CYBERARK_CCP_URL=
CYBERARK_APP_ID=
CYBERARK_SAFE=
CYBERARK_CLIENT_CERT=
CYBERARK_CLIENT_KEY=
CYBERARK_CA_BUNDLE=
CYBERARK_TIMEOUT=10
CYBERARK_CACHE_TTL=300

# --- Deploy-time DUMMY switches (backend analog of the UI's apiMocks) -------
# Once a request reaches the backend, these decide whether that screen serves canned dummy data
# (1/true) or calls its real DB/agent functions (0/false). Flip one screen to develop it live.
# (Oracle Command Center's own use_dummy lives in oraclecc/occ.json.)
ACCESS_USE_DUMMY=1          # Access/RBAC, Config Ops (incl. Upload), Regression, S-Studio
INFRA_HEALTH_USE_DUMMY=1    # Infrastructure Health
LOG_ANALYTICS_USE_DUMMY=1   # Log Analytics Hub (canned server catalogue + in-memory folder tree)

# --- Authentication / OpenID Connect (GLOBAL) ------------------------------
# Backend validation of the SPA's bearer token. OFF by default → the backend trusts the username in
# the request body (dev / dummy auth). Turn ON for real SSO: the token is verified against the IdP's
# JWKS and the caller is derived from it, never the body. Frontend OIDC is enabled separately
# (src/app/auth/sso.config.ts + environment.isSsoEnabled). FULL guide: AUTH_SETUP.md.
# Requires the `PyJWT[crypto]` package (imported lazily, only when this is 1).
# AUTH_VALIDATE_TOKEN=1
# When OIDC is OFF (AUTH_VALIDATE_TOKEN unset/0), authenticate every request AS this fixed UID — handy
# for debugging the backend without an IdP (curl/Postman, or the whole UI). Give it the access it needs
# in ols_users / ols_app_access (or, under ACCESS_USE_DUMMY=1, a name containing "ADMIN" for the canned
# admin). Leave blank to instead trust the username the frontend sends in the request body.
# AUTH_DEV_USER=OPS-10432
# OIDC_ISSUER=https://login.yourbank.com
# OIDC_AUDIENCE=ols-dashboard          # expected token `aud` (comma-separated allowed; empty = skip aud check)
# OIDC_JWKS_URL=                        # defaults to <OIDC_ISSUER>/.well-known/jwks.json when blank
# OIDC_USERNAME_CLAIM=preferred_username   # claim matching ols_users.USERNAME (falls back to `sub`)
# OIDC_ALGORITHMS=RS256                 # allowed signing algorithms (comma-separated)
# OIDC_LEEWAY=30                        # clock-skew tolerance (seconds) for exp/iat

# --- Database timeouts & concurrency (GLOBAL) — see DEPLOYMENT.md "Concurrency, workers & timeouts" ---
# Stops a hung query / dead DB from wedging the whole app (all requests "pending"). All read once at start.
# DB_CALL_TIMEOUT_MS: per-query ceiling (ms) — a hung query is cancelled, freeing its thread. GENEROUS by
#   design (safety net vs *infinite* hangs, not a per-query SLA); 0 = no timeout. Override per-endpoint in
#   code via connect(call_timeout_ms=...) for deliberately-long operations.
# DB_CALL_TIMEOUT_MS=60000
# DB_TCP_CONNECT_TIMEOUT_S: cap on opening a NEW connection so a dead listener fails fast.
# DB_TCP_CONNECT_TIMEOUT_S=5
# DB_ACQUIRE_TIMEOUT_S: if you wire a connection POOL, how long to wait for a free connection before a
#   fast 503 ("system busy") instead of hanging. (No effect until app.state DB configs are pools.)
# DB_ACQUIRE_TIMEOUT_S=5
# SLOW_REQUEST_MS: log any request slower than this (find the slow endpoint/query; tune the above from
#   real data). 0 disables.
# SLOW_REQUEST_MS=5000

# --- CORS (GLOBAL, local dev only) -----------------------------------------
# Prod needs NO CORS (ui_server.py proxies /api same-origin). Only for LOCAL dev (ng serve :4200 →
# backend :8000). Comma-separated; override only if you call the API cross-origin.
# OLS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Log Analytics ---------------------------------------------------------
# Max entries /dir returns per folder (anti-hang cap; 0 = unlimited).
# OLS_DIR_LIMIT=500
# /file serves whole file at/under this size (bytes); larger files are windowed.
# OLS_FILE_WINDOW_THRESHOLD=419430400

# ===========================================================================
# LEGACY per-screen env vars (moved to config/*.json). Kept here for reference — they still work as a
# FALLBACK when the matching JSON key is absent, but prefer the config files. Uncomment only to override
# without editing the JSON.
# ---------------------------------------------------------------------------
# Regression  → regression/regression.json  (these apply to ALL scopes as a fallback):
# REGRESSION_LOG_DIR=D:\ols\regression\logs
# REGRESSION_GIT_URL=
# REGRESSION_GIT_WORKDIR=D:\ols\regression\work
# REGRESSION_BRANCH_PREFIX=release/
# REGRESSION_SQL_SUBDIR=
# REGRESSION_FILECOPY_MANIFEST=
# REGRESSION_REFRESH_URL=
# REGRESSION_STEP_STALE_MINUTES=30
# REGRESSION_BATCH_MAX_ROWS=100000
#
# Oracle Command Center  → oraclecc/occ.json:
# ORACLE_CC_USE_DUMMY=1
# ORACLE_CC_SCHEMA=OLS
# ORACLE_CC_WARN_PCT=85
# ORACLE_CC_CRIT_PCT=90
# ORACLE_CC_TOP_CHILD_LIMIT=10
# ORACLE_CC_TEMP_WARN_MB=1024
# ORACLE_CC_TEMP_CRIT_MB=5120
# ORACLE_CC_FORCE_DOWN=
# SQLI_USE_DUMMY=1
# SQLI_HISTORY_DAYS=5
# SQLI_ALLOW_APPLY=1
# SQLI_MISESTIMATE_MIN_ROWS=1000
# SQLI_MISESTIMATE_WARN=10
# SQLI_MISESTIMATE_CRIT=100
# SQLI_STATS_STALE_DAYS=7
#
# Config Ops Upload  → config_ops/config_ops.json:
# CONFIG_UPLOAD_ARCHIVE_DIR=
# CONFIG_UPLOAD_MAX_ROWS=200000
# CONFIG_UPLOAD_MAX_MB=50
# CONFIG_UPLOAD_BATCH_SIZE=5000
# CONFIG_UPLOAD_AUDIT_COLUMNS=INSERTED_BY,INSERTED_DATE,INSERTED_ON,UPDATED_BY,UPDATED_DATE,UPDATED_ON
#
# Documentation Center  → docs/docs.json (base_dir from DOCS_BASE_DIR above; wikis/overrides in JSON):
# DOCS_BASE_DIR=D:\ols\docs

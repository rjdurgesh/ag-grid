<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{ email_title|default('OLS Batch Notification', true) }}</title>

  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->

  <style>
    :root {
      color-scheme: light dark;
      supported-color-schemes: light dark;
    }

    body,
    table,
    td,
    th,
    p,
    a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td,
    th {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }

    table {
      border-collapse: collapse;
    }

    body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      background-color: #eef2f6;
      font-family: Arial, Helvetica, sans-serif;
    }

    .preheader {
      display: none !important;
      visibility: hidden;
      opacity: 0;
      color: transparent;
      height: 0;
      width: 0;
      max-height: 0;
      max-width: 0;
      overflow: hidden;
      mso-hide: all;
      font-size: 1px;
      line-height: 1px;
    }

    .container {
      width: 700px;
      max-width: 700px;
    }

    .card {
      background-color: #ffffff;
      border: 1px solid #d8e1ea;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(18, 53, 91, 0.12);
    }

    .brand-bg {
      background-color: #12355b;
    }

    .body-text {
      color: #263238;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 15px;
      line-height: 24px;
      margin: 0;
    }

    .muted-text {
      color: #607d8b;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      line-height: 18px;
      margin: 0;
    }

    .summary-label {
      color: #78909c;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.7px;
      line-height: 15px;
      text-transform: uppercase;
    }

    .summary-value {
      color: #12355b;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 15px;
      font-weight: 700;
      line-height: 20px;
    }

    .rate-table th {
      background-color: #12355b;
      border: 1px solid #12355b;
      color: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      font-weight: 700;
      line-height: 17px;
      padding: 13px 12px;
      text-align: left;
      white-space: nowrap;
    }

    .rate-table td {
      border: 1px solid #dce4eb;
      color: #455a64;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 13px;
      line-height: 19px;
      padding: 13px 12px;
    }

    @media screen and (max-width: 720px) {
      .container {
        width: 100% !important;
        max-width: 100% !important;
      }

      .mobile-padding {
        padding-left: 18px !important;
        padding-right: 18px !important;
      }

      .mobile-stack {
        display: block !important;
        width: 100% !important;
      }

      .mobile-text-left {
        text-align: left !important;
      }

      .mobile-top-gap {
        padding-top: 12px !important;
      }

      .rate-table th,
      .rate-table td {
        font-size: 12px !important;
        line-height: 18px !important;
        padding: 10px 8px !important;
      }
    }

    @media (prefers-color-scheme: dark) {
      body,
      .email-bg {
        background-color: #111827 !important;
      }

      .card {
        background-color: #172033 !important;
        border-color: #344054 !important;
        box-shadow: none !important;
      }

      .body-text,
      .rate-table td {
        color: #d0d5dd !important;
      }

      .muted-text {
        color: #98a2b3 !important;
      }

      .summary-value {
        color: #f8fafc !important;
      }

      .summary-label {
        color: #b8c2cc !important;
      }
    }
  </style>
</head>

<body style="margin:0; padding:0; background-color:#eef2f6;">
  <div class="preheader">
    {{ preheader|default('Automated OLS batch notification.', true) }}
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-bg" style="width:100%; background-color:#eef2f6;">
    <tr>
      <td align="center" style="padding:32px 14px;">
        <!--[if mso]>
        <table role="presentation" width="700" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td>
        <![endif]-->

        <table role="presentation" width="700" cellpadding="0" cellspacing="0" border="0" class="container card" style="width:700px; max-width:700px; background-color:#ffffff; border:1px solid #d8e1ea; border-radius:8px; overflow:hidden;">
          <tr>
            <td class="brand-bg" style="background-color:#12355b;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="mobile-stack mobile-padding" width="58%" style="width:58%; padding:26px 30px; vertical-align:middle;">
                    <div style="font-family:Arial, Helvetica, sans-serif; font-size:28px; line-height:32px; font-weight:700; color:#ffffff; letter-spacing:1px;">
                      {{ brand_name|default('OLS', true) }}
                    </div>
                    <div style="margin-top:5px; font-family:Arial, Helvetica, sans-serif; font-size:11px; line-height:17px; color:#c8d7e7; letter-spacing:1px; text-transform:uppercase;">
                      {{ brand_subtitle|default('One Liquidity System', true) }}
                    </div>
                  </td>
                  <td class="mobile-stack mobile-padding mobile-text-left mobile-top-gap" width="42%" align="right" style="width:42%; padding:26px 30px; vertical-align:middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="right">
                      <tr>
                        <td style="padding:8px 12px; border:1px solid #7897b5; background-color:#1b4775; color:#ffffff; font-family:Arial, Helvetica, sans-serif; font-size:10px; line-height:14px; font-weight:700; letter-spacing:0.4px; text-transform:uppercase; white-space:nowrap;">
                          {{ notification_label|default('Automated Notification', true) }}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="mobile-padding" style="padding:22px 30px 0 30px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{ status_theme.bg_color }}; border:1px solid {{ status_theme.border_color }};">
                <tr>
                  <td width="5" style="width:5px; background-color:{{ status_theme.bar_color }}; font-size:1px; line-height:1px;">&nbsp;</td>
                  <td width="42" align="center" style="width:42px; padding:13px 0 13px 8px; vertical-align:middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" valign="middle" style="width:24px; height:24px; background-color:{{ status_theme.icon_bg_color }}; border-radius:50%; color:{{ status_theme.icon_color }}; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:24px; font-weight:700;">
                          {{ status_theme.icon_text|safe }}
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td style="padding:12px 15px 12px 8px; vertical-align:middle;">
                    <div style="font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:18px; font-weight:700; color:{{ status_theme.title_color }};">
                      {{ status_title|default(status_theme.title, true) }}
                    </div>
                    <div style="margin-top:2px; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:{{ status_theme.text_color }};">
                      {{ status_message|default(status_theme.message, true) }}
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="mobile-padding" style="padding:28px 30px 30px 30px;">
              <p class="body-text" style="margin:0 0 18px 0; color:#546e7a; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px;">
                {{ greeting|default('Dear All,', true) }}
              </p>

              <p class="body-text" style="margin:0 0 16px 0; color:#263238; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px;">
                This is an automated notification from <strong style="color:#12355b;">{{ system_name|default('OLS', true) }}</strong>. Please do not reply to this email.
              </p>

              <p class="body-text" style="margin:0 0 24px 0; color:#263238; font-family:Arial, Helvetica, sans-serif; font-size:15px; line-height:24px;">
                {{ body_message }}
              </p>

              {% if summary_items %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:25px;">
                <tr>
                  {% for item in summary_items %}
                  <td class="mobile-stack{% if not loop.first %} mobile-top-gap{% endif %}" width="{{ item.width|default(summary_item_width, true) }}" style="width:{{ item.width|default(summary_item_width, true) }}; {% if not loop.first %}padding-left:8px;{% endif %}{% if not loop.last %}padding-right:8px;{% endif %} vertical-align:top;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc; border:1px solid #dce4eb;">
                      <tr>
                        <td style="padding:14px;">
                          <div class="summary-label" style="color:#78909c; font-family:Arial, Helvetica, sans-serif; font-size:10px; font-weight:700; letter-spacing:0.7px; line-height:15px; text-transform:uppercase;">
                            {{ item.label }}
                          </div>
                          <div class="summary-value" style="margin-top:5px; color:#12355b; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:700; line-height:20px;">
                            {{ item.value }}
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                  {% endfor %}
                </tr>
              </table>
              {% endif %}

              {% if status == 'FAILED' %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px; background-color:#fff5f5; border:1px solid #fecaca;">
                <tr>
                  <td style="padding:14px 16px;">
                    <div style="font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:19px; color:#991b1b; font-weight:700;">
                      Batch failure details
                    </div>
                    <div style="margin-top:5px; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:20px; color:#7f1d1d;">
                      {{ error.message|default('The process failed before exchange-rate data could be retrieved.', true) }}
                    </div>
                    {% if error.batch_id|default('', true) %}
                    <div style="margin-top:8px; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#7f1d1d;">
                      <strong>Batch ID:</strong> {{ error.batch_id }}
                    </div>
                    {% endif %}
                    {% if error.reference|default('', true) %}
                    <div style="margin-top:4px; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#7f1d1d;">
                      <strong>Reference:</strong> {{ error.reference }}
                    </div>
                    {% endif %}
                  </td>
                </tr>
              </table>
              {% endif %}

              {% if status != 'FAILED' %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px; background-color:#f7f9fb; border:1px solid #dce4eb;">
                <tr>
                  <td style="padding:11px 14px; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:18px; color:#546e7a;">
                    <strong style="color:#37474f;">{{ table_heading_label|default('Exchange Rate Source:', true) }}</strong>
                    <span style="color:#12355b; font-weight:700;">{{ table_heading_value|default(interface_name, true) }}</span>
                  </td>
                </tr>
              </table>

              {% if rows %}
              <table role="table" aria-label="{{ table_aria_label|default(table_title, true) }}" width="100%" cellpadding="0" cellspacing="0" border="0" class="rate-table" style="width:100%; border-collapse:collapse; border:1px solid #d6dee5;">
                <tr>
                  {% for column in columns %}
                  <th scope="col" align="{{ column.align|default('left', true) }}" style="padding:13px 12px; background-color:#12355b; border:1px solid #12355b; color:#ffffff; font-family:Arial, Helvetica, sans-serif; font-size:12px; line-height:17px; font-weight:700; text-align:{{ column.align|default('left', true) }}; white-space:nowrap;">
                    {{ column.label }}
                  </th>
                  {% endfor %}
                </tr>

                {% for row in rows %}
                {% set row_bg = '#ffffff' if loop.index0 % 2 == 0 else '#f8fafc' %}
                <tr>
                  {% for column in columns %}
                  {% set cell_value = row.data.get(column.key, '') %}
                  {% set cell_extra_style = row.cell_styles.get(column.key, '') %}
                  {% set text_align = column.align|default('left', true) %}
                  {% set text_color = '#263238' if column.kind == 'number' else '#455a64' %}
                  <td align="{{ text_align }}" style="padding:13px 12px; border:1px solid #dce4eb; background-color:{{ row_bg }}; color:{{ text_color }}; font-family:{% if column.kind == 'number' %}Consolas, 'Courier New', monospace{% else %}Arial, Helvetica, sans-serif{% endif %}; font-size:13px; line-height:19px; {% if column.kind == 'number' or column.kind == 'code' %}font-weight:700;{% endif %} text-align:{{ text_align }}; {% if column.nowrap|default(false) %}white-space:nowrap;{% endif %} {{ cell_extra_style }}">
                    {% if column.kind == 'code' and cell_value %}
                    <span style="display:inline-block; color:#12355b; font-weight:700; white-space:nowrap;">{{ cell_value }}</span>
                    {% else %}
                    {{ cell_value }}
                    {% endif %}
                  </td>
                  {% endfor %}
                </tr>
                {% endfor %}
              </table>
              {% else %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px; background-color:#fffaf0; border:1px solid #fed7aa;">
                <tr>
                  <td style="padding:14px 16px; font-family:Arial, Helvetica, sans-serif; font-size:13px; line-height:20px; color:#7c2d12;">
                    {{ no_data_message|default('The batch completed, but no exchange-rate rows were available for this notification.', true) }}
                  </td>
                </tr>
              </table>
              {% endif %}
              {% endif %}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:28px;">
                <tr>
                  <td style="border-top:1px solid #e1e7ec; padding-top:20px;">
                    <p class="body-text" style="margin:0; color:#455a64; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:21px;">
                      Regards,
                    </p>
                    <p style="margin:4px 0 0 0; color:#12355b; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:21px; font-weight:700;">
                      {{ signature|default('OLS Team', true) }}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="mobile-padding" style="padding:18px 30px; background-color:#f5f7f9; border-top:1px solid #dce4eb;">
              <p class="muted-text" style="margin:0; color:#78909c; font-family:Arial, Helvetica, sans-serif; font-size:10px; line-height:16px;">
                This email was generated automatically by <strong>{{ footer_system_name|default('One Liquidity System (OLS)', true) }}</strong>. Please do not reply to this message.
              </p>
              <p class="muted-text" style="margin:7px 0 0 0; color:#90a4ae; font-family:Arial, Helvetica, sans-serif; font-size:10px; line-height:16px;">
                {{ footer_note|default('This notification is intended for authorized OLS users and system recipients.', true) }}
              </p>
            </td>
          </tr>
        </table>

        <!--[if mso]>
            </td>
          </tr>
        </table>
        <![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
